{
  "name": "thetoolx",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev:client & npm run dev:ssr",
    "dev:client": "cross-env NODE_ENV=development vite",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/server.ts",
    "dev:ssr": "cross-env NODE_ENV=development tsx watch server/ssr-server.ts",
    "build": "npm run build:client && npm run build:assets && npm run build:server && npm run build:ssr && npm run build:ssr-server",
    "build:client": "cross-env NODE_ENV=production vite build -c vite.config.ssr.ts",
    "build:assets": "node ./scripts/copy-assets.cjs",
    "build:server": "cross-env NODE_ENV=production vite build --config vite.config.server.ts",
    "build:ssr": "cross-env NODE_ENV=production vite build --config vite.config.server-ssr.ts",
    "build:ssr-server": "cross-env NODE_ENV=production vite build --config vite.config.ssr-server.ts",
    "build:copy-env": "cp .env dist/.env",
    "start": "cross-env NODE_ENV=production node dist/server/ssr-server.mjs",
    "start:spa": "cross-env NODE_ENV=production node dist/server/ssr-server.mjs",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:pm2:dev": "pm2 start ecosystem.config.js --env development",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "logs:pm2": "pm2 logs",
    "monitor:pm2": "pm2 monit",
    "preview": "cross-env NODE_ENV=production npm run build && npm run start",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
